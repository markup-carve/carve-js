{
  "name": "i01c-code-crlf",
  "description": "CRLF and lone CR line endings become line feeds in the payload.",
  "verdict": "unchanged",
  "clauses": [
    "C2-N-042",
    "C2-N-043",
    "C2-N-044",
    "C2-N-045"
  ],
  "resolver": "virtual",
  "expected": {
    "html": "<pre><code class=\"language-js\">a()\nb()\nc()\n</code></pre>",
    "fmt": "{{ a.js @code:js }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "a.js",
        "read": true
      }
    ]
  },
  "entry": "{{ a.js @code:js }}",
  "files": {
    "a.js": "a()\r\nb()\rc()\r\n"
  }
}

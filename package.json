{
  "name": "@markup-carve/carve",
  "version": "0.1.17",
  "type": "module",
  "description": "Reference TypeScript implementation of the Carve markup language",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Mark Scherer",
  "homepage": "https://markup-carve.github.io/carve/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-js.git"
  },
  "bugs": "https://github.com/markup-carve/carve-js/issues",
  "keywords": [
    "carve",
    "markup",
    "parser",
    "markdown",
    "djot",
    "prettier-plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/public/index.d.ts",
  "unpkg": "./dist/carve.iife.min.js",
  "jsdelivr": "./dist/carve.iife.min.js",
  "bin": {
    "carve": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/public/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/public/node.d.ts",
      "import": "./dist/node.js"
    },
    "./extensions": {
      "types": "./dist/types/public/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./import": {
      "types": "./dist/types/public/formats.d.ts",
      "import": "./dist/import.js"
    },
    "./export": {
      "types": "./dist/types/public/export.d.ts",
      "import": "./dist/export.js"
    },
    "./prettier": {
      "types": "./dist/types/public/prettier.d.ts",
      "import": "./dist/prettier.js"
    },
    "./upgrade": {
      "types": "./dist/types/public/upgrade.d.ts",
      "import": "./dist/upgrade.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/carve.iife.min.js.map",
    "README.md",
    "LICENSE",
    "action.yml",
    ".pre-commit-hooks.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/generate-package-info.ts && tsc -p upgrade/engine-0.1/tsconfig.json && npm ci --prefix import --ignore-scripts --silent && node cli/build.mjs && node public/build.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build:browser",
    "prepublishOnly": "node scripts/refuse-prerelease-publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/browser-bundle.mjs --selfcheck && node test/browser-bundle.mjs",
    "test:perf": "CARVE_PERF=1 vitest run --no-file-parallelism",
    "check:extension-migration": "tsc -p extensions/tsconfig.json && eslint --config extensions/eslint.config.mjs 'extensions/**/*.ts' 'test/extension-migration/**/*.ts' --max-warnings=0 && vitest run test/extension-migration",
    "test:stress": "CARVE_STRESS=1 vitest run test/writer.stress.test.ts",
    "test:proptest": "tsx --test proptest/*.test.ts",
    "fuzz": "node proptest/fuzz.ts",
    "test:cli": "vitest run --config cli/vitest.config.ts",
    "test:lint": "vitest run --config lint/vitest.config.mjs",
    "test:migrate": "tsx --test migrate/*.test.mts && tsc -p migrate/tsconfig.json",
    "test:package": "node scripts/check-package.mjs",
    "test:archive": "node scripts/check-archive-build.mjs",
    "generate:lint-catalog": "tsx lint/generate-catalog.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p proptest/tsconfig.json && tsc -p upgrade/engine-0.1/tsconfig.json --noEmit && npm run lint",
    "lint": "npm ci --prefix import --ignore-scripts --silent && eslint 'src/**/*.ts' 'public/**/*.ts' 'cli/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts' 'lint/**/*.ts' 'migrate/**/*.ts' 'proptest/**/*.ts' 'import/**/*.ts' 'upgrade/**/*.ts' --ignore-pattern 'upgrade/engine-0.1/**' --ignore-pattern 'extensions/**' --ignore-pattern 'test/extension-migration/**' --max-warnings=0",
    "check-public-types": "tsx scripts/check-public-types.ts",
    "enumerate": "tsx scripts/enumerate.ts",
    "enumerate-inline": "tsx scripts/enumerate-inline.ts",
    "enumerate-tree": "tsx scripts/enumerate-tree.ts",
    "stress-inline": "tsx scripts/stress-inline.ts",
    "stress-tree": "tsx scripts/stress-tree.ts",
    "stress-format": "tsx scripts/stress-format.ts",
    "fuzz-tree": "tsx scripts/fuzz-tree.ts",
    "conformance": "tsx scripts/conformance.ts",
    "bench": "tsx scripts/bench.ts",
    "writer-gates": "tsx scripts/writer-gates.ts",
    "mutate": "tsx scripts/mutate.ts",
    "differential": "tsx scripts/differential.ts",
    "differential-migrate": "tsx scripts/differential-migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "commonmark": "^0.31.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "marked": "^18.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-5-9": "npm:typescript@^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@djot/djot": "0.3.2",
    "micromark": "4.0.3",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-edit-map": "1.0.0",
    "parse5": "^7.3.0"
  }
}

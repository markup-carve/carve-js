{
  "name": "@markup-carve/carve",
  "version": "0.1.8",
  "type": "module",
  "description": "Reference TypeScript implementation of the Carve markup language",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Mark Scherer",
  "homepage": "https://markup-carve.github.io/carve/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-js.git"
  },
  "bugs": "https://github.com/markup-carve/carve-js/issues",
  "keywords": [
    "carve",
    "markup",
    "parser",
    "markdown",
    "djot",
    "prettier-plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/carve.iife.min.js",
  "jsdelivr": "./dist/carve.iife.min.js",
  "bin": {
    "carve": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./prettier": {
      "import": "./dist/prettier.js",
      "types": "./dist/prettier.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml",
    ".pre-commit-hooks.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:browser": "node scripts/build-browser.mjs",
    "drift": "node scripts/published-drift.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:browser": "node test/browser-bundle.mjs --selfcheck && node test/browser-bundle.mjs",
    "test:mxss": "node test/mxss.browser.mjs --selfcheck && node test/mxss.browser.mjs",
    "test:perf": "CARVE_PERF=1 vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:includes": "vitest run test/include-conformance.test.ts",
    "ledger:render": "UPDATE_RENDER_LEDGER=1 vitest run test/corpus-render-ledger.test.ts",
    "lint": "eslint src/source-positions.ts src/own-property.ts src/html-import-dom.ts src/attribute-merge.ts src/inline-resolution.ts src/inline-children.ts src/unresolved-reference.ts src/block-children.ts src/attribute-parser.ts src/html-import-code-language.ts src/label-key.ts src/link-destination.ts src/source-layout.ts src/tab-normalize.ts src/paragraph-indent.ts src/thematic-break-marker.ts src/colon-fences.ts src/math-block.ts src/smart-quotes.ts src/trim-non-nbsp.ts src/sentinel-run.ts src/table-spans.ts src/import-report-messages.ts src/conversion-diagnostics.ts src/deny-listed-destination.ts src/reference-state.ts --max-warnings=0 && node scripts/check-lint.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.boundaries.json && npm run lint",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@djot/djot": "^0.3.2",
    "@types/node": "^22.19.20",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@djot/djot": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "@djot/djot": {
      "optional": true
    }
  },
  "dependencies": {
    "parse5": "^7.3.0"
  }
}

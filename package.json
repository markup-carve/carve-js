{
  "name": "@markup-carve/carve",
  "version": "0.1.17",
  "type": "module",
  "description": "Reference TypeScript implementation of the Carve markup language",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Mark Scherer",
  "homepage": "https://markup-carve.github.io/carve/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-js.git"
  },
  "bugs": "https://github.com/markup-carve/carve-js/issues",
  "keywords": [
    "carve",
    "markup",
    "parser",
    "markdown",
    "djot"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/public/index.d.ts",
  "unpkg": "./dist/carve.iife.min.js",
  "jsdelivr": "./dist/carve.iife.min.js",
  "bin": {
    "carve": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/public/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/public/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml",
    ".pre-commit-hooks.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p upgrade/engine-0.1/tsconfig.json && npm ci --prefix import --ignore-scripts --silent && node cli/build.mjs && node public/build.mjs",
    "build:browser": "node scripts/build-browser.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "node scripts/refuse-prerelease-publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node test/browser-bundle.mjs --selfcheck && node test/browser-bundle.mjs",
    "test:mxss": "node test/mxss.browser.mjs --selfcheck && node test/mxss.browser.mjs",
    "check:extension-migration": "tsc -p extensions/tsconfig.json && eslint --config extensions/eslint.config.mjs 'extensions/**/*.ts' 'test/extension-migration/**/*.ts' --max-warnings=0 && vitest run test/extension-migration",
    "test:stress": "CARVE_STRESS=1 vitest run test/writer.stress.test.ts",
    "test:proptest": "node --test proptest/*.test.ts",
    "test:cli": "vitest run --config cli/vitest.config.ts",
    "test:lint": "vitest run --config lint/vitest.config.mjs",
    "test:migrate": "node --test migrate/*.test.mts && tsc -p migrate/tsconfig.json",
    "test:package": "node scripts/check-package.mjs",
    "generate:lint-catalog": "node lint/generate-catalog.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p proptest/tsconfig.json && tsc -p upgrade/engine-0.1/tsconfig.json --noEmit && npm run lint",
    "lint": "npm ci --prefix import --ignore-scripts --silent && eslint 'src/**/*.ts' 'public/**/*.ts' 'cli/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts' 'lint/**/*.ts' 'migrate/**/*.ts' 'proptest/**/*.ts' 'import/**/*.ts' 'upgrade/**/*.ts' --ignore-pattern 'upgrade/engine-0.1/**' --ignore-pattern 'extensions/**' --ignore-pattern 'test/extension-migration/**' --max-warnings=0",
    "check-public-types": "node scripts/check-public-types.ts",
    "enumerate": "node scripts/enumerate.ts",
    "enumerate-inline": "node scripts/enumerate-inline.ts",
    "enumerate-tree": "node scripts/enumerate-tree.ts",
    "stress-inline": "node scripts/stress-inline.ts",
    "stress-tree": "node scripts/stress-tree.ts",
    "stress-format": "node scripts/stress-format.ts",
    "fuzz-tree": "node scripts/fuzz-tree.ts",
    "conformance": "node scripts/conformance.ts",
    "bench": "node scripts/bench.ts",
    "writer-gates": "node scripts/writer-gates.ts",
    "mutate": "node scripts/mutate.ts",
    "differential": "node scripts/differential.ts",
    "differential-migrate": "node scripts/differential-migrate.ts"
  },
  "devDependencies": {
    "@djot/djot": "^0.3.2",
    "@types/node": "^22.19.20",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "commonmark": "^0.31.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "marked": "^18.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "typescript": "^5.7.2",
    "typescript-5-9": "npm:typescript@^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@djot/djot": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "@djot/djot": {
      "optional": true
    }
  },
  "dependencies": {
    "parse5": "^7.3.0"
  }
}

{
  "name": "@markup-carve/carve",
  "version": "0.1.3",
  "type": "module",
  "description": "Reference TypeScript implementation of the Carve markup language",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Mark Scherer",
  "homepage": "https://markup-carve.github.io/carve/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-js.git"
  },
  "bugs": "https://github.com/markup-carve/carve-js/issues",
  "keywords": [
    "carve",
    "markup",
    "parser",
    "markdown",
    "djot",
    "prettier-plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/carve.iife.min.js",
  "jsdelivr": "./dist/carve.iife.min.js",
  "bin": {
    "carve": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./prettier": {
      "import": "./dist/prettier.js",
      "types": "./dist/prettier.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml",
    ".pre-commit-hooks.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:browser": "node scripts/build-browser.mjs",
    "drift": "node scripts/published-drift.mjs",
    "prepare": "npm run build && npm run build:browser",
    "test": "vitest run",
    "test:mxss": "node test/mxss.browser.mjs --selfcheck && node test/mxss.browser.mjs",
    "test:perf": "CARVE_PERF=1 vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@djot/djot": "^0.3.2",
    "@types/node": "^22.19.20",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@djot/djot": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "@djot/djot": {
      "optional": true
    }
  },
  "dependencies": {
    "parse5": "^7.3.0"
  }
}
